# Builds the static web app and serves it with nginx, which also routes /api/<service> to the services.
#   docker build -f deploy/Dockerfile.web -t campus-space-web .

ARG NODE_IMAGE=node:24-alpine

FROM ${NODE_IMAGE} AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH CI=1
RUN corepack enable
WORKDIR /repo
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json turbo.json tsconfig.base.json vitest.shared.mjs ./
COPY packages/contracts ./packages/contracts
COPY apps/web ./apps/web
COPY scripts ./scripts
RUN pnpm install --frozen-lockfile --filter "@campus/web..."
RUN pnpm turbo run build --filter=@campus/web

FROM nginx:1.27-alpine AS runtime
COPY deploy/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /repo/apps/web/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=15s --timeout=3s --retries=5 CMD wget -qO- http://127.0.0.1/healthz || exit 1
