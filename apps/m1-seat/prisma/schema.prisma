// M1 study-seat reservation plus room/seat master data (D-2), schema "m1". Owner: module group 1.
// Migrations: pnpm --filter @campus/m1-seat db:migrate:dev --name <change>

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("M1_DATABASE_URL")
}

/// Study room (D-2 master data). departmentId null = open to the whole campus (REQ-M1-02).
/// width/height are the floor-plan size in abstract grid units (REQ-M1-10).
model Room {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  building     String
  floor        Int
  /// Opening hours as "HH:mm" local time; reservations must fall inside (REQ-M1-02).
  openFrom     String
  openTo       String
  departmentId String?
  isActive     Boolean       @default(true)
  width        Int           @default(12)
  height       Int           @default(8)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  seats        Seat[]
  outlets      PowerOutlet[]

  @@index([building])
  @@map("rooms")
}

/// Registered seat with a unique code inside its room and a position on the floor plan.
model Seat {
  id             String       @id @default(cuid())
  roomId         String
  code           String
  x              Int          @default(0)
  y              Int          @default(0)
  /// Deprecated since REQ-M1-10: derived from power_outlets at read time. Kept for one
  /// release so the previous image can still run against this schema (expand/contract).
  hasPowerOutlet Boolean      @default(false)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  room           Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  statuses       SeatStatus[]
  reservations   Reservation[]

  @@unique([roomId, code])
  @@map("seats")
}

enum PowerOutletKind {
  FIXED
  RAIL
}

/// A power outlet on the floor plan; seats within `range` grid units of it count as powered
/// (REQ-M1-09 as derived by REQ-M1-10).
model PowerOutlet {
  id        String          @id @default(cuid())
  roomId    String
  code      String
  kind      PowerOutletKind @default(FIXED)
  x         Int
  y         Int
  range     Int             @default(1)
  createdAt DateTime        @default(now())
  room      Room            @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([roomId, code])
  @@map("power_outlets")
}

/// Mirrors SeatStatusSource in @campus/contracts. Every status row records who wrote it (X-3).
enum SeatStatusSource {
  M1_RESERVATION
  M2_ROOM_BOOKING
  M3_REPAIR
}

enum SeatStatusKind {
  RESERVED
  BLOCKED
}

/// A time window during which a seat is unavailable, with provenance for tracing and audit.
model SeatStatus {
  id        String           @id @default(cuid())
  seatId    String
  kind      SeatStatusKind
  source    SeatStatusSource
  /// Reservation id (M1), booking id (M2) or ticket id (M3) in the source module.
  refId     String
  from      DateTime
  to        DateTime
  createdAt DateTime         @default(now())
  seat      Seat             @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@index([seatId, from, to])
  @@index([source, refId])
  @@map("seat_statuses")
}

enum ReservationStatus {
  BOOKED
  CANCELLED
}

/// A student holding one seat for one time window (REQ-M1-04). Every BOOKED reservation has a
/// matching seat_statuses row (kind RESERVED, source M1_RESERVATION, refId = reservation id);
/// the exclusion constraint on seat_statuses (see migration add_reservations) is what makes
/// double booking impossible, not application code. Check-in and no-show states arrive with
/// REQ-M1-05/06.
model Reservation {
  id           String            @id @default(cuid())
  seatId       String
  roomId       String
  userId       String
  from         DateTime
  to           DateTime
  status       ReservationStatus @default(BOOKED)
  cancelReason String?
  cancelledAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  seat         Seat              @relation(fields: [seatId], references: [id], onDelete: Cascade)

  @@index([userId, from])
  @@index([seatId, from, to])
  @@index([roomId, from])
  @@map("reservations")
}

/// Module-local parameters managed by administrators (REQ-M1-01/04): reservation.maxHours,
/// reservation.slotMinutes, room.timezone. Values are strings; parsing lives in settings.service.ts.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt

  @@map("settings")
}
