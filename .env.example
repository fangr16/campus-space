# Copy to .env for local development. Never commit .env.
# One PostgreSQL instance, one schema per service (see ADR-0003).
POSTGRES_USER=campus
POSTGRES_PASSWORD=campus
POSTGRES_DB=campus
POSTGRES_PORT=5432

# Service-specific connection strings (schema selected per service).
PLATFORM_DATABASE_URL=postgresql://campus:campus@localhost:5432/campus?schema=platform
M1_DATABASE_URL=postgresql://campus:campus@localhost:5432/campus?schema=m1
M2_DATABASE_URL=postgresql://campus:campus@localhost:5432/campus?schema=m2
M3_DATABASE_URL=postgresql://campus:campus@localhost:5432/campus?schema=m3

# Shared secrets. Generate real values for test/prod with `openssl rand -hex 32`.
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_EXPIRES_IN=8h
INTERNAL_SERVICE_TOKEN=dev-only-internal-token

# Service ports (local dev). Nginx fronts them on :8080 in docker compose.
PLATFORM_PORT=3001
M1_PORT=3011
M2_PORT=3012
M3_PORT=3013
WEB_PORT=5173

# Base URLs the services use to call each other (local dev).
PLATFORM_BASE_URL=http://localhost:3001
M1_BASE_URL=http://localhost:3011
M2_BASE_URL=http://localhost:3012
M3_BASE_URL=http://localhost:3013

# Build metadata injected by CI; defaults keep local /version meaningful.
GIT_SHA=local
GIT_TAG=untagged
BUILD_TIME=
