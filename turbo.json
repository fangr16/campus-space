{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalEnv": ["NODE_ENV", "CI", "VITEST_INTEGRATION"],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate"]
    },
    "test": {
      "dependsOn": ["^build", "generate"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "env": ["DATABASE_URL", "JWT_SECRET", "INTERNAL_SERVICE_TOKEN"]
    },
    "mutation": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["reports/**"]
    },
    "db:migrate": {
      "cache": false,
      "env": ["DATABASE_URL"],
      "dependsOn": ["generate"]
    },
    "db:seed": {
      "dependsOn": ["db:migrate"],
      "cache": false,
      "env": ["DATABASE_URL"]
    },
    "dev": {
      "dependsOn": ["^build", "generate"],
      "cache": false,
      "persistent": true
    },
    "generate": {
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["generated/**"]
    }
  }
}
